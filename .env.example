# Copy this file to ".env" (same folder as README.md), edit it, then restart the backend.
# Never put a comment on the same line as a value. Comments go on their own line.

# ---- 1. Which AI to use ----------------------------------------------------------------
# Use "mock" to run with NO key at all (browsing, graphs, review, tests all work; AI answers do not).
# Use "gemini" or "openai" for real AI answers, and fill in the matching key below.
LLM_PROVIDER=mock

# Needed only if LLM_PROVIDER=gemini. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Needed only if LLM_PROVIDER=openai. Get one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# The model name. Leave empty and the app picks a current Gemini Flash model for your key by itself.
# To choose one yourself, put its name here (Google's own error message suggested: gemini-3.8-flash).
LLM_MODEL=

# ---- 2. Needed to run your own projects ------------------------------------------------
# Lets you import a folder from your computer.
ALLOW_LOCAL_PATHS=true

# Runs tests on your machine. Without this, tests need Docker and show "Not executed".
SANDBOX_MODE=local

# Keep as is.
EMBEDDING_PROVIDER=hash
